def carregar_dados(caminho="dados_energia.json"):
    caminhos_possiveis = [caminho]
    try:
        base_dir = os.path.dirname(os.path.abspath(_file_))
        caminhos_possiveis.insert(0, os.path.join(base_dir, caminho))
    except NameError:
        pass

    for arq in caminhos_possiveis:
        if os.path.exists(arq):
            with open(arq, "r", encoding="utf-8") as f:
                return json.load(f)

    return DADOS_PADRAO

def calcular_diagnostico(pessoas, minutos_banho, potencia_watts, moradia, dados):
    meta = dados["metadata"]
    alt_efic = dados["alternativas"]["eficiencia_energetica"]
    alt_solar = dados["alternativas"]["fonte_renovavel_solar"]

    tarifa = meta["tarifa_media_kwh_brl"]
    fator_co2 = meta["fator_emissao_co2_kg_kwh"]
    dias = meta["periodo_referencia_dias"]

    # 1. Cenário Atual
    potencia_kw = potencia_watts / 1000.0
    horas_mes_atual = (pessoas * minutos_banho * dias) / 60.0
    kwh_atual = potencia_kw * horas_mes_atual
    custo_atual = kwh_atual * tarifa
    co2_atual = kwh_atual * fator_co2

    # 2. Alternativa 1: Eficiência Energética
    horas_mes_efic = horas_mes_atual * alt_efic["fator_reducao_tempo"]
    kwh_efic = alt_efic["potencia_media_kw"] * horas_mes_efic
    custo_efic = kwh_efic * tarifa
    economia_brl_efic = custo_atual - custo_efic
    payback_efic = (
        alt_efic["custo_implantacao_brl"] / economia_brl_efic
        if economia_brl_efic > 0 else 0
    )
    co2_evitado_efic = (kwh_atual - kwh_efic) * fator_co2

    # 3. Alternativa 2: Fonte Renovável (Aquecedor Solar Térmico)
    kwh_solar = kwh_atual * (1 - alt_solar["fracao_solar_media"])
    custo_solar = kwh_solar * tarifa
    economia_brl_solar = custo_atual - custo_solar
    payback_solar = (
        alt_solar["custo_implantacao_brl"] / economia_brl_solar
        if economia_brl_solar > 0 else 0
    )
    co2_evitado_solar = (kwh_atual - kwh_solar) * fator_co2

    return {
        "atual": {"kwh": kwh_atual, "custo": custo_atual, "co2": co2_atual},
        "eficiencia": {
            "kwh": kwh_efic,
            "custo": custo_efic,
            "economia_brl": economia_brl_efic,
            "investimento": alt_efic["custo_implantacao_brl"],
            "payback_meses": payback_efic,
            "co2_evitado": co2_evitado_efic,
            "km_carro_evitados": co2_evitado_efic / meta["equivalencia_co2_km_carro"]
        },
        "solar": {
            "kwh": kwh_solar,
            "custo": custo_solar,
            "economia_brl": economia_brl_solar,
            "investimento": alt_solar["custo_implantacao_brl"],
            "payback_meses": payback_solar,
            "co2_evitado": co2_evitado_solar,
            "km_carro_evitados": co2_evitado_solar / meta["equivalencia_co2_km_carro"]
        },
        "moradia": moradia
    }

