def iniciar_chat():
    dados = carregar_dados()
    print("Olá! Sou o Citizen Assist AI. Vou ajudar você a reduzir o gasto com energia no banho.\n")
    try:
        pessoas = int(input("1. Quantas pessoas moram na residência? (Ex: 4): ") or 4)
        minutos = float(input("2. Qual a duração média de cada banho em minutos? (Ex: 10): ") or 10)
        potencia = float(input("3. Qual a potência do seu chuveiro atual em Watts? (Ex: 5500): ") or 5500)
        print("4. Qual o tipo da sua moradia?")
        print("   [1] Casa própria (com acesso ao telhado/laje)")
        print("   [2] Apartamento ou imóvel alugado")
        moradia = input("   Escolha (1 ou 2): ").strip() or "1"

        resultado = calcular_diagnostico(pessoas, minutos, potencia, moradia, dados)
        exibir_resposta_assistente(resultado, dados)
    except ValueError:
        print("Erro: Por favor, insira apenas valores numéricos válidos.")

if __name__ == "__main__":
    iniciar_chat()
